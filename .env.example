# Copy this file to .env.local and fill in real values. Never commit real keys.

# App URL (optional, used for absolute links)
NEXT_PUBLIC_URL=http://localhost:3000

# Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Supabase (https://supabase.com/dashboard -> Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Preferred: the new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# Legacy fallback: the old anon JWT key. Used only if the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# Set to "true" AFTER you have (1) added Clerk as a third-party auth provider in
# Supabase and (2) applied supabase/migrations/002_clerk_rls_policies.sql.
# When enabled, every Supabase request is sent with the user's Clerk session token
# so Row Level Security can scope rows to auth.jwt()->>'sub'.
SUPABASE_CLERK_AUTH=false

# Playwright E2E (optional). Authenticated tests are skipped when these are empty.
# Use a dedicated Clerk test user with password sign-in enabled, e.g. e2e+clerk_test@example.com
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
